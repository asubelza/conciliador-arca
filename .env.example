# Copy this file to `.env` (gitignored) and fill in real values before
# running `docker compose up`. Docker Compose loads `.env` automatically
# from the project root -- no extra flag needed.

# --- Postgres ---
POSTGRES_USER=conciliador
POSTGRES_PASSWORD=conciliador
POSTGRES_DB=conciliador_arca

# --- Auth (packages/api/src/auth/jwt.ts) ---
# Any non-empty string works for local dev. Rotate before this stack is
# ever reachable outside this machine.
JWT_SECRET=change-me-before-sharing-this-stack

# --- Gmail SMTP (for local/dev testing — see nodemailer + a Google
# "App Password", not your real Gmail password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Must be reachable from the end user's browser (the `web` service's
# published port), not the Docker-network hostname.
APP_BASE_URL=http://localhost:3001

# --- Web (baked into the browser bundle at build time) ---
# Must be reachable from the end user's browser, not the Docker network.
NEXT_PUBLIC_API_URL=http://localhost:3002
