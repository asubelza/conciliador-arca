{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "rootDir": ".",
  "moduleNameMapper": {
    "^shared-types$": "<rootDir>/../shared-types/src"
  },
  "testMatch": ["<rootDir>/src/**/*.test.ts"],
  "collectCoverageFrom": ["src/**/*.ts"],
  "setupFiles": ["<rootDir>/jest.setup-env.ts"],
  "testTimeout": 20000
}
